# Copia este archivo como ".env" para probar en local (".env" nunca se sube a GitHub).
# En Vercel / Render define estas mismas variables en el panel del servicio.

# --- Base de datos (Turso = SQLite en la nube) ---
# Si las dejas vacías, en local se usa el archivo data/notas.db y todo funciona igual.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Servidor ---
PORT=3000

# --- Límites (opcionales; estos son los valores por defecto) ---
# Megabytes de archivos (imagen + adjunto) por guardado. En Vercel no pases de 3.
MAX_MEDIA_MB=3
# Máximo de notas en toda la base de datos
MAX_NOTAS=1000
# Peticiones por minuto y por IP: lecturas y escrituras (crear/editar/borrar)
RATE_LIMIT_READ=300
RATE_LIMIT_WRITE=40
